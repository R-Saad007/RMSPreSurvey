# Copy to .env and fill in. Never commit .env.
# The secrets marked (secret) are set with  python -m tools.set_secret <NAME>  so they're never typed on a
# command line or pasted anywhere else. Discord values are checked with Discord before they're saved.

# --- Discord -------------------------------------------------------------
DISCORD_BOT_TOKEN=              # (secret) Bot page -> Reset Token

# The bot's application is also what people connect their Discord through
# (one link, once) and how an HQ admin adds the bot to a new server.
# Developer Portal -> your app -> OAuth2: the client id is on that page; add the
# redirect  <PORTAL_BASE_URL>/oauth/discord/callback  and reset the secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=          # (secret)

# --- Servers -------------------------------------------------------------
# One Discord server per company and region, e.g. "FieldCo_South". Past this
# many sites a region gets a second server ("FieldCo_South_2"). Discord caps a
# server at 500 channels including categories; 450 sites in 9 categories fits.
SITES_PER_SERVER=450

# --- Roles (functional only; site access is a per-channel overwrite) ------
MANAGEMENT_ROLE_NAME=Management
ENGINEER_ROLE_NAME=Engineer
COORDINATOR_ROLE_NAME=Coordinator
TECHNICIAN_ROLE_NAME=Technician

# --- Server layout -------------------------------------------------------
# A server holds site categories and site channels, nothing else.
ACCESS_THREAD_NAME=🔒 access & config
SITE_CATEGORY_SIZE=50
CHANNEL_COUNT_WARN_AT=400
CHANNEL_COUNT_CEILING=480

# --- Blur check ----------------------------------------------------------
# Laplacian variance; lower means blurrier. Tune against real site photos —
# 100 is a starting point, not a measured value.
BLUR_VARIANCE_THRESHOLD=100.0

# --- Portal --------------------------------------------------------------
# PORTAL_SECRET_KEY signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it, everyone is signed out whenever the portal restarts.
PORTAL_SECRET_KEY=
# The public https:// address. Every link that leaves the portal (emails,
# WhatsApp, Discord's sign-in) is built from it. In production Caddy
# terminates TLS and proxies to PORTAL_HOST:PORTAL_PORT on loopback.
PORTAL_BASE_URL=https://portal.example.com
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000

# --- Personal links ------------------------------------------------------
# How many days a person's link can be used to connect Discord the first time.
# Once they've connected it stays their page of sites for good.
JOIN_LINK_DAYS=14

# --- Email (links go out by email when the person has an address) -------
# Any SMTP mailbox. Gmail: turn on 2-Step Verification, make an App Password,
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=                  # (secret)
SMTP_FROM=RMS Control Tower <you@example.com>

# --- Storage -------------------------------------------------------------
TIMEZONE_NAME=Asia/Karachi
STORAGE_ROOT=storage/sites
DB_PATH=rms_bot.sqlite3
